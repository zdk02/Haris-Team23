# Haris configuration — copy this file to `.env` and fill in.
# Committing `.env.example` (not `.env`) is the convention: it documents the knobs without
# leaking real secrets. `.env` is git-ignored.

# Operator token that gates the dashboard. REQUIRED — the dashboard exposes the security
# audit log and fails closed (access denied) if this is blank. Set a strong value here;
# whoever is authorized to view the dashboard enters it to sign in.
HARIS_DASHBOARD_TOKEN=change-me-to-a-strong-token

# Incoming Slack/Discord webhook URL for runtime + CI alerts. Optional — leave blank to
# disable (the Notifier no-ops if unset, so local runs never break).
HARIS_ALERT_WEBHOOK=

# Secret key for the audit log's hash chain. Set this and the chain becomes KEYED (HMAC):
# an attacker who can write the log cannot recompute it to hide their tracks. Generate once
# with:  python -c "import secrets; print(secrets.token_hex(32))"
# Leave blank and the chain degrades to a plain hash — corruption-evident, not tamper-evident.
# NEVER commit the real value. Changing it invalidates every record written under the old key.
HARIS_AUDIT_KEY=


# Amazon SES email alerting. Optional — leave blank to disable (the channel no-ops if unset).
# Sandbox requires BOTH sender and recipients to be verified SES identities.
# The deployed ECS task deliberately does NOT use this: its task role carries no policies, and
# alerting for "Haris is down" is out-of-process (CloudWatch -> SNS -> email), because an
# in-process alerter cannot report its own absence.
HARIS_SES_SENDER=
HARIS_SES_RECIPIENTS=
HARIS_SES_REGION=us-east-1