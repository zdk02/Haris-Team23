# Haris configuration — copy this file to `.env` and fill in as needed.
# Both variables are OPTIONAL. Committing `.env.example` (not `.env`) is the convention:
# it documents the knobs without leaking real secrets.

# Operator token that gates the dashboard. Leave blank for local dev (dashboard runs open,
# with a visible notice). Set a value to require operator sign-in.
HARIS_DASHBOARD_TOKEN=

# Incoming Slack/Discord webhook URL for runtime + CI alerts. Leave blank to disable
# (the Notifier no-ops if unset, so local runs never break).
HARIS_ALERT_WEBHOOK=